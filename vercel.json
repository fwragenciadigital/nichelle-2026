{
  "version": 2,
  "buildCommand": "node vercel/build.mjs",
  "outputDirectory": "vercel/dist",
  "framework": null,
  "headers": [
    {
      "source": "/nichelle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
