{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nichelle Imports — configurações públicas de módulos exclusivos FWR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "const": "nichelle-2026"
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videoGallery"
      ],
      "properties": {
        "videoGallery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "title",
            "placement",
            "mobileMode",
            "openMode",
            "items"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "title": {
              "type": "string",
              "maxLength": 90
            },
            "placement": {
              "type": "string",
              "enum": [
                "pending",
                "after-brand-strip"
              ]
            },
            "mobileMode": {
              "type": "string",
              "enum": [
                "pending",
                "scroll-snap",
                "grid"
              ]
            },
            "openMode": {
              "type": "string",
              "enum": [
                "pending",
                "modal",
                "inline"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "enabled",
                  "order",
                  "provider",
                  "videoUrl",
                  "alt"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "youtube",
                      "mp4",
                      "vimeo"
                    ]
                  },
                  "posterUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^(https://|$)",
                    "description": "Opcional para YouTube Shorts: thumbnail automática do próprio vídeo. Obrigatório para MP4/Vimeo."
                  },
                  "videoUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "description": "YouTube Shorts, watch, youtu.be, MP4 ou Vimeo com HTTPS."
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 180
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "productUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "autoplay": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "provider": {
                          "enum": [
                            "mp4",
                            "vimeo"
                          ]
                        }
                      },
                      "required": [
                        "provider"
                      ]
                    },
                    "then": {
                      "required": [
                        "posterUrl"
                      ],
                      "properties": {
                        "posterUrl": {
                          "pattern": "^https://"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "items": {
                    "contains": {
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      },
                      "required": [
                        "enabled"
                      ]
                    },
                    "minContains": 4,
                    "maxContains": 4
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
